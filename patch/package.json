{
  "name": "astra-book",
  "version": "3.0.0",
  "private": true,
  "description": "Astra Book - leitor de livros",
  "scripts": {
    "build:billing": "esbuild scripts/purchase-bridge.js --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=www/purchase-plugin.js",
    "build:ads": "esbuild scripts/ads-bridge.js --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=www/ads-plugin.js",
    "sync": "pnpm run build:billing && pnpm run build:ads && pnpm exec cap sync android"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.0",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "8.3.0",
    "capacitor-plugin-cdv-purchase": "13.19.1",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.25.12"
  }
}
